@baseUrl = http://localhost:8000
@newUsername = rest-client-user
@newEmail = rest-client@cslab.pt
@newPassword = RestClient123!
@adminUsername = super-admin
@adminEmail = super-admin@cslab.pt
@adminPassword = AdminPass123!
@userEmail = training-user@cslab.pt
@userPassword = TrainingPass123!

### 0. Tokens captured from the login/register responses below
# The REST Client can capture a response header with:
#   # @name accessToken
#   POST {{baseUrl}}/api/auth/login
@accessToken = {{login-response.body.access_token}}
@adminAccessToken = {{adminLogin-response.body.access_token}}

### 1. Backend health check
# Expected: 200
GET {{baseUrl}}/api/health

### 2. List blog posts
# Expected: 200 with the three CTF posts
GET {{baseUrl}}/api/posts

### 3. Register a new user
# Expected: 201 the first time; 409 if this user already exists.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "{{newUsername}}",
  "email": "{{newEmail}}",
  "password": "{{newPassword}}"
}

### 4. Login with the newly registered username
# Expected: 200 with the created user's id, username, email, role and access_token.
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identity": "{{newUsername}}",
  "password": "{{newPassword}}"
}

### 5. Login with the newly registered email
# Expected: 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identity": "{{newEmail}}",
  "password": "{{newPassword}}"
}

### 6. Login as the seeded super-admin
# Controlled training account. Expected: 200 with id 1, role admin and an access_token.
# @name adminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identity": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

### 7. Login as the seeded training user by email
# Expected: 200 with id 2, role user and an access_token.
# @name userLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identity": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 8. Login as the seeded super-admin by email
# Expected: 200 with id 1 and role admin.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identity": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 9. Invalid login
# Expected: 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identity": "{{adminUsername}}",
  "password": "WrongPassword123!"
}

### 10. Dashboard profile request, as the frontend sends it
# Expected: 200 with your own profile. Copy the access_token from request 7
# into @accessToken first.
GET {{baseUrl}}/api/user?id=2
Authorization: Bearer {{accessToken}}

### 11. Dashboard profile request without a token
# Expected: 401
GET {{baseUrl}}/api/user?id=2

### 12. Dashboard profile request with an invalid token
# Expected: 401
GET {{baseUrl}}/api/user?id=2
Authorization: Bearer not-a-real-token

### 13. Training exercise: change the id in request 10 to 1
# Expected: 200 with the super-admin profile, including its access_token.
# This is the intentional IDOR used for the exercise.
GET {{baseUrl}}/api/user?id=1
Authorization: Bearer {{accessToken}}

### 14. Restricted admin area with a normal user token
# Expected: 403
GET {{baseUrl}}/api/admin/me
Authorization: Bearer {{accessToken}}

### 15. Restricted admin area with the token from request 13
# Expected: 200 with the super-admin profile.
GET {{baseUrl}}/api/admin/me
Authorization: Bearer {{adminAccessToken}}

